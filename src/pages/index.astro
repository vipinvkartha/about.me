---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import NavMenu from '../components/NavMenu.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

type Highlight = string | { text: string; items: string[] };

// Counted at build time, so the number updates on each deploy
const careerStart = new Date('2014-09-01');
const yearsOfExperience = Math.floor((Date.now() - careerStart.getTime()) / (365.25 * 24 * 60 * 60 * 1000));

const profile = {
  name: "Vipin V Kartha",
  firstName: "Vipin",
  pronunciation: {
    phonetic: "vi-pin",
    audio: "/audio/vipin.mp3"
  },
  title: "Senior Backend Engineer",
  company: "Babbel",
  location: "Berlin, Germany",
  contact: {
    phone: "+49 178 1723761",
    email: "vipinvkartha@gmail.com",
    linkedin: "https://linkedin.com/in/vipinvkartha",
    github: "https://github.com/vipinvkartha"
  },
  about: [
    `With over ${yearsOfExperience} years of hands-on experience in developing robust, large-scale distributed backend systems, I am passionate about using new technologies and methods to build scalable and extensible applications. My domain experience spans EdTech, E-commerce, IoT and Healthcare, which helps me bring practical solutions to different industries.`,
    "As a polyglot developer, I believe in selecting the right technology for each specific challenge.",
    "Currently, I am a Senior Backend Engineer at Babbel. I work on the company's internal AI platform, which helps teams build and run AI agents securely, and on authentication services in the Identity team."
  ],
  skills: [
    { category: "Programming", items: ["Node.js", "TypeScript", "Golang", "Ruby on Rails", "C++"] },
    { category: "AI Platform", items: ["AWS Bedrock AgentCore", "MCP", "Langfuse", "OpenTelemetry"] },
    { category: "Identity", items: ["OAuth 2.0", "OpenID Connect", "SAML", "Okta"] },
    { category: "Back-end", items: ["REST API", "GraphQL", "Express", "TypeORM", "Elasticsearch", "Kinesis", "Firebase", "MQTT"] },
    { category: "DevOps", items: ["AWS", "ECS Fargate", "Lambda", "SQS", "SNS", "CloudWatch", "Terraform", "Docker", "New Relic"] },
    { category: "Database", items: ["MySQL", "DynamoDB", "Redis"] }
  ],
  experience: [
    {
      company: "Babbel GmbH",
      location: "Berlin, Germany",
      roles: [
        {
          title: "Senior Backend Engineer, AI Platform",
          period: "Jun 2026 – Present",
          highlights: [
            "Working on the AI platform team, using TypeScript (Node.js), AWS, Terraform, Langfuse and OpenTelemetry.",
            "Developing and maintaining a platform that lets other teams build and run AI agents securely.",
            "Building and maintaining the platform's AWS infrastructure with Terraform, including monitoring and alerts.",
            {
              text: "Leading multiple initiatives in the team, including:",
              items: [
                "Agent platform, from design to production",
                "AI agent that triages customer-support bug reports",
                "MCP connectors for the company's AI tool gateway"
              ]
            }
          ]
        },
        {
          title: "Senior Backend Engineer, Identity",
          period: "Jul 2022 – Present",
          highlights: [
            "Working on the authentication team, using Node.js (TypeScript), Golang, Ruby on Rails, AWS, Docker, DynamoDB and MySQL.",
            "Developing and maintaining microservices to improve the scalability and performance of authentication services.",
            "Collaborating closely with the infrastructure team.",
            {
              text: "Led multiple initiatives in the team, including:",
              items: [
                "CAPTCHA implementation for the entire backend",
                "Authentication restriction management for B2B customers",
                "Session management for web and mobile login",
                "Deprecation of the legacy home app"
              ]
            }
          ]
        }
      ]
    },
    {
      company: "KeyValue Software Systems",
      location: "Kochi, India",
      roles: [
        {
          title: "Senior Software Engineer, Staff Software Engineer",
          period: "Apr 2020 – Jun 2022",
          highlights: [
            "Core member of the team building a B2B product for small retail owners across Indonesia.",
            "Built Node.js (TypeScript) and Golang microservices on AWS, exposing REST and GraphQL APIs.",
            "Deployed services with AWS CodePipeline and monitored them with AWS CloudWatch.",
            "Built asynchronous processing with AWS SQS and S3."
          ]
        }
      ]
    },
    {
      company: "Siemens Technology and Services",
      location: "Bangalore, India",
      roles: [
        {
          title: "Software Engineer (L2)",
          period: "Nov 2018 – Apr 2020",
          highlights: [
            "Backend developer on an IoT project for industrial devices, working in C, C++ and Node.js.",
            "Worked with the industrial protocols HART, Modbus and OPC UA.",
            "Implemented several REST APIs.",
            "Worked on the physical layer for hardware communication over RS-485 and RS-232 using Modbus."
          ]
        }
      ]
    },
    {
      company: "CitiusTech Healthcare Technology Pvt Ltd",
      location: "Mumbai, India",
      roles: [
        {
          title: "Software Engineer",
          period: "Sep 2017 – Nov 2018",
          highlights: [
            "Fixed defects and built enhancements for a healthcare image viewer application, using VC++ and MFC."
          ]
        }
      ]
    },
    {
      company: "HCL Technologies (formerly Geometric Limited)",
      location: "Pune, India",
      roles: [
        {
          title: "Software Engineer",
          period: "Oct 2016 – Jul 2017",
          highlights: [
            "Worked on the development of the DFMPRO product, using VC++ and CAA V6.",
            "Integrated DFMPRO with the CATIA CAD software."
          ]
        }
      ]
    },
    {
      company: "Aricent Technologies",
      location: "Chennai, India",
      roles: [
        {
          title: "Software Engineer",
          period: "Sep 2014 – Sep 2016",
          highlights: [
            "Maintained and developed a customer product that decodes and analyses live traffic.",
            "Worked in C++ on both Linux and Windows."
          ]
        }
      ]
    }
  ] as { company: string; location: string; roles: { title: string; period: string; highlights: Highlight[] }[] }[],
  education: [
    {
      degree: "B.Tech. in Computer Science and Engineering",
      school: "TKM College of Engineering",
      location: "Kollam, India",
      period: "2010 – 2014"
    }
  ],
  awards: [
    { year: "2019", title: "Spot Award for Best Performance", issuer: "Siemens Technology and Services" },
    { year: "2014", title: "Best Project Award", issuer: "Aricent Training Program" }
  ]
};

const description = `${profile.name} is a ${profile.title} at ${profile.company} in ${profile.location}, working on AI platform and authentication systems with Node.js (TypeScript), Golang, Ruby on Rails and AWS.`;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  worksFor: { "@type": "Organization", name: profile.company },
  address: { "@type": "PostalAddress", addressLocality: "Berlin", addressCountry: "DE" },
  email: `mailto:${profile.contact.email}`,
  sameAs: [profile.contact.linkedin, profile.contact.github]
};
---

<Layout title={`${profile.name} – ${profile.title}`} description={description} schema={personSchema}>
  <NavMenu />
  <!-- Theme Toggle -->
  <div class="fixed top-4 right-4 md:top-6 md:right-6 z-50">
    <ThemeToggle />
  </div>

  <main class="min-h-screen bg-zinc-950 py-12 px-4 md:pl-32 md:pr-6 text-zinc-100">
    <div class="max-w-3xl mx-auto space-y-20">
      <!-- Profile Header -->
      <ScrollReveal class="section-card">
        <header class="section-content p-6 md:p-8 rounded-lg">
          <div class="flex flex-col items-center text-center">
            <!-- Hire Me Button -->
            <div class="relative group mb-8">
              <button
                id="hireButton"
                aria-haspopup="true"
                aria-expanded="false"
                aria-controls="hireDropdown"
                class="relative flex items-center gap-2.5 px-6 py-2.5 text-sm font-medium bg-zinc-900 text-zinc-100 rounded-lg shadow-lg border border-zinc-800 hover:bg-zinc-800 hover:border-zinc-700 transition-all duration-300"
              >
                <span class="font-semibold">Hire Me</span>
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
                </span>
              </button>

              <!-- Dropdown Menu -->
              <div id="hireDropdown" class="hidden absolute left-1/2 -translate-x-1/2 mt-2 w-52 bg-zinc-900 border border-zinc-800 rounded-lg shadow-lg z-50 text-left">
                <a
                  href="https://wa.me/491781723761"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center gap-3 px-4 py-3 text-sm text-zinc-100 hover:bg-zinc-800 transition-all duration-300 rounded-t-lg group"
                >
                  <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  <span class="group-hover:translate-x-0.5 transition-transform duration-300">WhatsApp</span>
                </a>
                <a
                  href={`mailto:${profile.contact.email}`}
                  class="flex items-center gap-3 px-4 py-3 text-sm text-zinc-100 hover:bg-zinc-800 transition-all duration-300 rounded-b-lg group"
                >
                  <svg class="w-5 h-5 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                  <span class="group-hover:translate-x-0.5 transition-transform duration-300">Email</span>
                </a>
              </div>
            </div>

            <!-- Profile Image -->
            <div class="mb-10 relative group">
              <div class="absolute -inset-1 bg-gradient-to-r from-zinc-500 to-zinc-600 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <div class="relative w-44 h-44 md:w-52 md:h-52 rounded-full overflow-hidden border-2 border-zinc-800/50 p-0.5">
                <img
                  src="/profile.jpg"
                  alt={profile.name}
                  width="208"
                  height="208"
                  class="w-full h-full object-cover rounded-full filter transition-all duration-500 group-hover:scale-105"
                />
              </div>
            </div>

            <!-- Profile Info -->
            <h1 class="text-4xl font-light mb-2 tracking-wide">{profile.name}</h1>
            <div class="flex items-center gap-2 mb-3">
              <span class="text-sm text-zinc-400 font-light tracking-wide" title={`How to pronounce ${profile.firstName}`}>
                /{profile.pronunciation.phonetic}/
              </span>
              <button
                id="pronounceButton"
                class="text-zinc-500 hover:text-zinc-300 transition-colors relative group"
                title="Listen to pronunciation"
                aria-label="Listen to name pronunciation"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                  />
                </svg>
                <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-1 h-1 bg-zinc-400 rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></span>
              </button>
              <audio id="pronounceAudio" src={profile.pronunciation.audio} preload="none"></audio>
            </div>
            <p class="text-lg text-zinc-400 mb-2">{profile.title} at {profile.company}</p>
            <p class="text-sm text-zinc-500 mb-6">{profile.location}</p>

            <div class="flex flex-col items-center gap-6">
              <!-- Contact Links -->
              <div class="flex flex-wrap justify-center gap-3 md:gap-6 mb-4">
                {Object.entries(profile.contact).map(([key, value]) => (
                  <a
                    href={key === 'email' ? `mailto:${value}` : key === 'phone' ? `tel:${value.replace(/[^+\d]/g, '')}` : value}
                    target={key === 'linkedin' || key === 'github' ? '_blank' : undefined}
                    rel={key === 'linkedin' || key === 'github' ? 'noopener noreferrer' : undefined}
                    class="group relative p-2.5 bg-zinc-900 rounded-lg hover:bg-zinc-800/80 transition-all duration-300"
                    title={key === 'linkedin' ? 'Connect on LinkedIn' : key === 'github' ? 'View GitHub Profile' : value}
                    aria-label={key === 'linkedin' ? 'LinkedIn profile' : key === 'github' ? 'GitHub profile' : undefined}
                  >
                    {key === 'linkedin' ? (
                      <svg class="w-5 h-5 text-zinc-400 group-hover:text-[#0A66C2] transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                      </svg>
                    ) : key === 'github' ? (
                      <svg class="w-5 h-5 text-zinc-400 group-hover:text-zinc-100 transition-colors duration-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                      </svg>
                    ) : (
                      <div class="flex items-center gap-2">
                        {key === 'email' ? (
                          <svg class="w-5 h-5 text-zinc-400 group-hover:text-emerald-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                          </svg>
                        ) : (
                          <svg class="w-5 h-5 text-zinc-400 group-hover:text-blue-400 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                          </svg>
                        )}
                        <span class="text-sm text-zinc-400 group-hover:text-zinc-100 transition-colors duration-300">{value}</span>
                      </div>
                    )}
                  </a>
                ))}
              </div>

              <!-- CV Actions -->
              <div class="flex flex-wrap justify-center gap-4">
                <a
                  href="/vipin_kartha_cv.pdf"
                  download
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-zinc-300 bg-zinc-900 border border-zinc-800 rounded-lg hover:bg-zinc-800/80 hover:border-zinc-700 transition-all duration-300 group"
                >
                  <span class="group-hover:text-zinc-100 transition-colors duration-300">Download CV</span>
                  <svg
                    class="w-4 h-4 text-zinc-400 group-hover:text-emerald-400 transition-colors duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                </a>

                <button
                  id="previewCV"
                  class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-zinc-300 bg-zinc-900 border border-zinc-800 rounded-lg hover:bg-zinc-800/80 hover:border-zinc-700 transition-all duration-300 group"
                >
                  <span class="group-hover:text-zinc-100 transition-colors duration-300">Preview CV</span>
                  <svg
                    class="w-4 h-4 text-zinc-400 group-hover:text-blue-400 transition-colors duration-300"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        </header>
      </ScrollReveal>

      <!-- About -->
      <ScrollReveal class="section-card">
        <section id="about" class="section-content p-6 md:p-8 rounded-lg">
          <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-6">About</h2>
          <div class="text-zinc-300 leading-relaxed space-y-4 font-light">
            {profile.about.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>
      </ScrollReveal>

      <!-- Skills -->
      <ScrollReveal class="section-card">
        <section id="skills" class="section-content p-6 md:p-8 rounded-lg">
          <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-6">Skills</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
            {profile.skills.map(group => (
              <div>
                <h3 class="text-zinc-400 text-sm mb-3">{group.category}</h3>
                <ul class="flex flex-wrap gap-2">
                  {group.items.map(item => (
                    <li class="skill-tag px-2.5 py-1 text-xs rounded-md border">{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>
      </ScrollReveal>

      <!-- Experience -->
      <ScrollReveal class="section-card">
        <section id="experience" class="section-content p-6 md:p-8 rounded-lg">
          <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-12">Experience</h2>

          <div class="timeline-flow">
            {profile.experience.map((job) => (
              <div class="timeline-item">
                <div class="timeline-node"></div>
                <div class="timeline-curve"></div>

                <div class="timeline-content">
                  <div class="timeline-header">
                    <h3 class="text-xl text-zinc-200 font-light">{job.company}</h3>
                    <p class="timeline-details text-sm text-zinc-500">{job.location}</p>
                  </div>

                  <div class="space-y-8">
                    {job.roles.map(role => (
                      <div>
                        <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
                          <p class="text-sm font-medium text-zinc-300">{role.title}</p>
                          <p class="text-sm text-zinc-500">{role.period}</p>
                        </div>
                        <ul class="space-y-2 text-sm text-zinc-400">
                          {role.highlights.map(highlight => (
                            <li class="flex items-start gap-3">
                              <span class="text-zinc-600 mt-px" aria-hidden="true">―</span>
                              {typeof highlight === 'string' ? (
                                <span class="flex-1">{highlight}</span>
                              ) : (
                                <div class="flex-1">
                                  <span>{highlight.text}</span>
                                  <ul class="mt-2 space-y-1.5">
                                    {highlight.items.map(item => (
                                      <li class="flex items-start gap-2.5">
                                        <span class="text-zinc-600" aria-hidden="true">·</span>
                                        <span class="flex-1">{item}</span>
                                      </li>
                                    ))}
                                  </ul>
                                </div>
                              )}
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      </ScrollReveal>

      <!-- Education and Awards -->
      <ScrollReveal class="section-card">
        <section id="education" class="section-content p-6 md:p-8 rounded-lg">
          <h2 class="text-sm uppercase tracking-widest text-zinc-500 mb-6">Education</h2>
          <div class="space-y-4">
            {profile.education.map(entry => (
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <div>
                  <h3 class="text-zinc-200">{entry.degree}</h3>
                  <p class="text-sm text-zinc-400">{entry.school}, {entry.location}</p>
                </div>
                <p class="text-sm text-zinc-500">{entry.period}</p>
              </div>
            ))}
          </div>

          <h2 class="text-sm uppercase tracking-widest text-zinc-500 mt-12 mb-6">Awards</h2>
          <ul class="space-y-3">
            {profile.awards.map(award => (
              <li class="flex gap-4 text-sm">
                <span class="text-zinc-500 tabular-nums">{award.year}</span>
                <span class="text-zinc-400"><span class="text-zinc-200">{award.title}</span>, {award.issuer}</span>
              </li>
            ))}
          </ul>
        </section>
      </ScrollReveal>

      <footer class="text-center text-xs text-zinc-500 pb-4">
        © {new Date().getFullYear()} {profile.name}
      </footer>
    </div>
  </main>
</Layout>

<div id="cvModal" class="fixed inset-0 bg-black/80 z-50 hidden overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="cvModalTitle">
  <div class="min-h-screen px-4 flex items-center justify-center">
    <div class="bg-zinc-900 rounded-lg max-w-4xl w-full relative">
      <!-- Header -->
      <div class="flex justify-between items-center p-4 border-b border-zinc-800">
        <h3 id="cvModalTitle" class="text-lg font-medium text-zinc-200">Curriculum Vitae</h3>
        <button
          id="closeModal"
          class="text-zinc-400 hover:text-zinc-200 transition-colors"
          aria-label="Close modal"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="p-6">
        <object
          data="/vipin_kartha_cv.pdf"
          type="application/pdf"
          class="w-full h-[calc(100vh-12rem)] rounded"
        >
          <p class="text-zinc-400 text-center py-8">
            Unable to display PDF.
            <a
              href="/vipin_kartha_cv.pdf"
              download
              class="text-blue-400 hover:text-blue-300 underline"
            >
              Download instead
            </a>
          </p>
        </object>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('cvModal');
  const previewButton = document.getElementById('previewCV');
  const closeButton = document.getElementById('closeModal');

  function closeCvModal() {
    modal?.classList.add('hidden');
    document.body.style.overflow = 'auto';
    previewButton?.focus();
  }

  // Open modal
  previewButton?.addEventListener('click', () => {
    modal?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    closeButton?.focus();
  });

  closeButton?.addEventListener('click', closeCvModal);

  // Close on outside click
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeCvModal();
  });

  // Pronunciation audio playback
  const pronounceButton = document.getElementById('pronounceButton');
  const pronounceAudio = document.getElementById('pronounceAudio') as HTMLAudioElement | null;
  let isPlaying = false;

  if (pronounceButton && pronounceAudio) {
    pronounceButton.addEventListener('click', () => {
      if (!isPlaying) {
        isPlaying = true;
        pronounceButton.classList.add('text-zinc-300');

        pronounceAudio.play().catch(error => {
          isPlaying = false;
          pronounceButton.classList.remove('text-zinc-300');
          console.error('Error playing audio:', error);
        });

        pronounceAudio.addEventListener('ended', () => {
          isPlaying = false;
          pronounceButton.classList.remove('text-zinc-300');
        }, { once: true });
      }
    });
  }

  // Hire Me dropdown
  const hireButton = document.getElementById('hireButton');
  const hireDropdown = document.getElementById('hireDropdown');

  function setHireDropdown(open: boolean) {
    hireDropdown?.classList.toggle('hidden', !open);
    hireButton?.setAttribute('aria-expanded', String(open));
  }

  hireButton?.addEventListener('click', () => {
    setHireDropdown(hireDropdown?.classList.contains('hidden') ?? false);
  });

  // Close dropdown when clicking outside
  document.addEventListener('click', (e) => {
    if (!hireButton?.contains(e.target as Node)) setHireDropdown(false);
  });

  // Escape closes whichever popup is open
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!modal?.classList.contains('hidden')) closeCvModal();
    setHireDropdown(false);
  });
</script>
